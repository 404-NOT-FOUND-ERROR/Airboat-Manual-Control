+static size_t workbench_text(char *out, size_t limit, const char *text, size_t bytes)
+{
+    size_t used = 0;
+    for (size_t at = 0; at < bytes && text[at];) {
+        const unsigned char ch = (unsigned char)text[at];
+        const size_t codepoint = ch < 0x80U ? 1U : ch < 0xe0U ? 2U : ch < 0xf0U ? 3U : 4U;
+        const bool escape = ch == '"' || ch == '\\';
+        const size_t encoded = ch < 0x20U || escape ? 2U : codepoint;
+        if (used + encoded > limit || at + codepoint > bytes) break;
+        if (ch < 0x20U) {
+            out[used++] = '\\';
+            out[used++] = ch == '\n' ? 'n' : ch == '\r' ? 'r' : 't';
+        } else {
+            if (escape) out[used++] = '\\';
+            memcpy(out + used, text + at, codepoint);
+            used += codepoint;
+        }
+        at += codepoint;
+    }
+    return used;
+}
+
+static int workbench_snapshot(const struct app_remote *s, char *out, size_t size)
+{
+    const app_remote_workbench_t *w = &s->workbench;
+    const int head = snprintf(out, size,
+        "{\"face\":{\"catalog\":\"%s\",\"semantic\":\"%s\",\"generation\":%lu,"
+        "\"frame\":%u,\"frames\":%u,\"fps\":%u,\"active\":%s,\"playing\":%s,"
+        "\"listening\":%s,\"listen_frame\":%u,\"mirror\":%s,\"loop\":%s},"
+        "\"dialogue\":{\"phase\":\"%s\",\"turn\":%lu,\"revision\":%lu,\"input\":\"",
+        w->catalog ? w->catalog : "", w->semantic ? w->semantic : "",
+        (unsigned long)w->generation, (unsigned)w->frame, (unsigned)w->frames, (unsigned)w->fps,
+        w->active ? "true" : "false", w->playing ? "true" : "false",
+        w->listening ? "true" : "false", (unsigned)w->listen_frame, w->mirror ? "true" : "false",
+        w->loop ? "true" : "false",
+        w->phase, (unsigned long)w->turn, (unsigned long)w->revision);
+    const char separator[] = "\",\"output\":\"";
+    const char end[] = "\"}}";
+    if (head < 0 || (size_t)head + sizeof(separator) + sizeof(end) >= size) {
+        snprintf(out, size, "{\"error\":\"workbench-size\"}");
+        return 500;
+    }
+    size_t used = (size_t)head;
+    const size_t limit = size - used - (sizeof(separator) - 1U) - sizeof(end);
+    const size_t input_limit = limit / 2U;
+    const size_t input = workbench_text(out + used, input_limit, w->input, sizeof(w->input));
+    used += input;
+    memcpy(out + used, separator, sizeof(separator) - 1U);
+    used += sizeof(separator) - 1U;
+    used += workbench_text(out + used, limit - input, w->output, sizeof(w->output));
+    memcpy(out + used, end, sizeof(end));
+    return 200;
+}
